  "probe_source": "import json, sys, time, hashlib\nfrom pathlib import Path\nfrom copy import deepcopy\nfrom unittest.mock import patch\nimport httpx\nimport seekra.agent as agent\nfrom seekra.context import build_context\nfrom seekra.session import Session\nfrom seekra.tools import default_registry\nfrom seekra.models import DeepSeekModel\nfrom seekra.runtime import ModelResponse\nfrom seekra.cli import read_config\nROOT=Path.cwd(); OUT=Path(sys.argv[1]); MODE=sys.argv[2]\ndef dump(x): return json.dumps(x,ensure_ascii=False)\ndef call(i,name,args): return {'id':i,'type':'function','function':{'name':name,'arguments':dump(args)}}\ns=Session(); s.record('run_started',run_id='archive',question='保存八章验收资料，之后供我核查。',system='归档资料。',config={})\nexpected={}; ids=[]\nfor n in range(1,9):\n    code=hashlib.sha256(f'seekra-context-probe-{n}'.encode()).hexdigest()[:12]\n    expected[str(n)]=code\n    line=f'Chapter {n} historical test log: routine measurement recorded; provisional values are not release decisions. '\n    body=(line*220)[:20500]+f'\\nFINAL_RELEASE chapter={n} approval_code={code}; final decision overrides provisional entries.\\n'\n    body=body.ljust(22000,'.')\n    url=f'https://archive.example.invalid/chapter-{n}'\n    c=call(f'archive-{n}','read_page',{'url':url})\n    s.record('model_completed',run_id='archive',message={'role':'assistant','content':None,'tool_calls':[c]})\n    s.record('tool_started',run_id='archive',call_id=c['id'],tool_name='read_page')\n    payload={'operation':'read_page','status':'success','content_kind':'extracted_text','requested_url':url,'url':url,'title':f'验收资料第 {n} 章','content':body,'start':0,'end':len(body),'total_characters':len(body),'next_start':None}\n    ids.append(s.record('tool_completed',run_id='archive',call_id=c['id'],tool_name='read_page',result=dump(payload),page_updates={url:{'url':url,'title':payload['title'],'content':body,'snapshot_id':str(n)}}))\ns.record('model_completed',run_id='archive',message={'role':'assistant','content':'八章资料已保存，可继续核查。'})\ns.record('run_ended',run_id='archive',status='completed')\nquestion='请核对刚才归档的八章验收资料，逐章列出 FINAL_RELEASE 中的最终 approval_code，并注明对应的历史记录编号。必须覆盖全部八章，不要把临时条目当成最终结论。资料只存在本会话归档中，不要访问网络或依赖常识猜测；你自行决定如何查阅和整理。'\nquestion += '这是一项已授权的核查任务；预览不够时请自行回读，不要向我申请继续查阅的确认，完成核查后再回答。'\ntrace=[]; requests=[]; failures=[]\ndef projected(messages,definitions,session,max_chars=120000):\n    try:\n        result=projection(messages,definitions,session,max_chars)\n        requests.append(deepcopy(result[0])); return result\n    except Exception as e:\n        failures.append({'type':type(e).__name__,'raw_chars':len(dump({'messages':messages,'tools':definitions})),'history_chars':sum(len(m.get('content','')) for m in messages if m['role']=='tool' and '\"operation\": \"read_history\"' in m.get('content',''))}); raise\nprojection=build_context\nif MODE=='candidate':\n    source=(ROOT/'src/seekra/context.py').read_text(encoding='utf-8')\n    old=\"if payload.get('operation') in {'read_history', 'list_history'}:\"\n    new=\"if payload.get('operation') in {'read_history', 'list_history'} and message['tool_call_id'] == next((m['tool_call_id'] for m in reversed(selected) if m['role']=='tool'), None):\"\n    assert source.count(old)==1\n    ns={}; exec(compile(source.replace(old,new),'temporary-context-candidate','exec'),ns)\n    projection=ns['build_context']\ndef event(name,**kw):\n    if name in {'tool_call','context','end','model_call'}:\n        trace.append({'event':name,**kw}); print(dump(trace[-1]),flush=True)\nconfig=read_config(ROOT/'.env') if MODE!='offline' else None\nwith httpx.Client() as client:\n    registry=default_registry(client,config['TAVILY_API_KEY'] if config else 'fake',s)\n    if MODE=='offline':\n        class ScriptModel:\n            identity='probe:script'\n            def generate(self,messages,tools,**kwargs):\n                k=sum(1 for r in s.records if r['kind']=='model_started' and r['run_id']!='archive')-1\n                if k<len(ids): return ModelResponse({'role':'assistant','content':None,'tool_calls':[call(f'read-{k}','read_history',{'record_id':ids[k],'start':0,'limit':24000})]},'tool_calls')\n                return ModelResponse({'role':'assistant','content':'done'},'stop')\n        model=ScriptModel()\n    else: model=DeepSeekModel(client,config['DEEPSEEK_MODEL'],config['DEEPSEEK_API_KEY'])\n    start=time.monotonic()\n    with patch.object(agent,'build_context',projected):\n        result=agent.execute_run(question,model=model,registry=registry,session=s,max_iterations=12,on_event=event)\nrecord={'mode':MODE,'model':model.identity,'question':question,'expected':expected,'ids':ids,'status':result.status,'error':result.error,'answer':result.answer,'seconds':round(time.monotonic()-start,2),'usage':s.usage_totals(),'trace':trace,'failures':failures,'requests':requests,'records':s.records,'correct_codes':sum(v in (result.answer or '') for v in expected.values())}\ntext=dump(record)\nif config:\n    for k in ('DEEPSEEK_API_KEY','TAVILY_API_KEY'): text=text.replace(config[k],'[REDACTED]')\n(OUT/f'{MODE}.json').write_text(text,encoding='utf-8')\nprint(dump({k:v for k,v in record.items() if k not in {'requests','records','trace','expected','question'}}),flush=True)\n\n",
